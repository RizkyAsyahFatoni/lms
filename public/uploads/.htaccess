# ==============================================================================
# LMS KABUPATEN BERAU - UPLOAD HARDENING SECURITY CONFIGURATION
# Mencegah eksekusi skrip (WebShell) dan eksploitasi berkas pada direktori uploads
# ==============================================================================

# 1. Matikan Directory Browsing dan eksekusi skrip CGI
Options -Indexes -ExecCGI

# 2. Matikan Engine PHP (mod_php pada berbagai versi Apache)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 3. Blokir akses langsung ke ekstensi skrip yang berpotensi menjadi WebShell
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|cgi|pl|exe|sh|py|rb|asp|aspx|jsp|shtml)$">
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# 4. Paksa penanganan file sebagai plain binary untuk mencegah MIME Sniffing pada berkas teks
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
